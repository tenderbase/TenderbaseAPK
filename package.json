{
  "name": "tenderbase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --test src/lib/__tests__/*.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "db:push": "supabase db push",
    "smoke": "./smoke-test.sh",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@supabase/ssr": "0.5.1",
    "@supabase/supabase-js": "2.45.4",
    "clsx": "2.1.1",
    "lucide-react": "0.451.0",
    "next": "^14.2.35",
    "pdf-parse": "^2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
}
