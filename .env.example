# Supabase (auth + saved tenders + preferences)
NEXT_PUBLIC_SUPABASE_URL=https://ddkmarfxkyukhgmzdazz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# TenderBase Ingestion API — server-side only.
# Public: no key required. This URL is also the built-in default, so you can
# leave the whole block out for local development.
TENDERBASE_API_URL=https://tenderbase-api-rqrh.onrender.com

# Sent as X-API-Key only when set, so auth can be enabled upstream later
# without a code change. Not required by any endpoint today.
# TENDERBASE_API_KEY=

# Used by the Supabase admin paths only. Never exposed to the client.
TENDERBASE_ADMIN_SECRET=your-admin-secret

# Skip the network and serve src/lib/fixtures/tender-api.ts (real captures from
# the live API). Useful in CI, offline, or in a sandbox with no egress.
# TENDERBASE_FIXTURES_ONLY=true

# Upstream cold-starts on Render's free tier. Default 20000ms.
# TENDERBASE_API_TIMEOUT_MS=20000

# Browser-direct fallback. When the SERVER cannot reach the API (egress
# allowlists in sandboxes/preview hosts, corporate networks, an upstream
# timeout) the app retries the same request against the API from the browser,
# which is usually on a less restricted network. The API is public and
# CORS-open, so this needs no key and exposes no secret — the UI labels those
# rows as fetched in the browser. Defaults to the URL above; set it to a
# different host, or disable the fallback entirely, from here.
# NEXT_PUBLIC_TENDERBASE_API_URL=https://tenderbase-api-rqrh.onrender.com
# NEXT_PUBLIC_TENDERBASE_DIRECT_FALLBACK=false

# Dev-only auth bypass for sandboxed previews where the OAuth redirect URI
# cannot be allowlisted. Ignored unless NODE_ENV !== 'production'.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# ---------------------------------------------------------------------------
# PayFast billing (U8) — server-side only. These are never sent to the client;
# the checkout API signs server-side and returns a signed form.
# ---------------------------------------------------------------------------
# Merchant credentials from your PayFast dashboard (or the sandbox dashboard at
# https://sandbox.payfast.co.za). Until these are set, every billing surface
# reports an honest "not configured" state instead of a dead button.
# PAYFAST_MERCHANT_ID=10000100
# PAYFAST_MERCHANT_KEY=46f0cd694581a
# The passphrase set in the PayFast dashboard. PayFast REQUIRES it for
# subscription payments and for every Recurring Billing API call (cancelling
# included), and we need it to verify ITNs. Set it there and here, or payments,
# ITNs and cancellations will all be rejected.
# PAYFAST_PASSPHRASE=
# Sandbox mode: checkout and ITN confirmation use sandbox.payfast.co.za.
# PAYFAST_SANDBOX=true

# Service role key — the ONLY writer of billing rows (RLS has no client write
# policy; a subscription row is what unlocks Pro). Needed for checkout and ITN.
# Never exposed to the client.
# SUPABASE_SERVICE_ROLE_KEY=

# Public origin used to build PayFast return/cancel/notify URLs. REQUIRED in
# production: the request Host header is never trusted for these, because a
# forged Host would move the ITN (and the post-payment redirect) to another
# domain. Set it to the exact origin customers use, e.g. https://tenderbase.app
# Outside production the request host is used when this is unset, so local and
# sandboxed previews need nothing configured.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Extra origins that may be used as the PayFast return/cancel/notify host when
# NEXT_PUBLIC_SITE_URL is unset (comma-separated, e.g. a tunnel plus staging).
# Hosts are matched exactly; an unlisted host gets an honest 503 rather than a
# signed form pointed somewhere nobody configured.
# TENDERBASE_ALLOWED_HOSTS=tenderbase.app,preview-tenderbase.app
