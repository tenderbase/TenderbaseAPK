# Supabase (auth + saved tenders + preferences)
# See GOOGLE-AUTH-SETUP.md for how to obtain these.
# Both are safe to expose to the browser; the anon key is constrained by RLS.
# NEVER put the service_role key here -- it bypasses every security policy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# South African Tender API — server-side only, never NEXT_PUBLIC_
# Live instance: https://tenderbase-api.onrender.com/docs
TENDERBASE_API_URL=https://tenderbase-api.onrender.com/api/v1
TENDERBASE_API_KEY=your-api-key

# Admin endpoints (key management, manual sync). Optional.
TENDERBASE_ADMIN_SECRET=your-admin-secret

# Google Gemini / GroqCloud AI — server-side only, never NEXT_PUBLIC_
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-1.5-flash

# GroqCloud free key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# Dev-only auth bypass for sandboxed previews where the OAuth redirect URI
# cannot be allowlisted. Ignored unless NODE_ENV !== 'production'.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
